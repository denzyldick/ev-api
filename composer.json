{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "denzyl/ev-api",
    "description": "REST API built with Laravel and FrankenPHP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/octane": "^2.25"
    },
    "require-dev": {
        "carthage-software/mago": "^1.61",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php artisan test",
        "analyse": "@php vendor/bin/mago analyze",
        "lint": "@php vendor/bin/mago lint",
        "format": "@php vendor/bin/mago format",
        "format:check": "@php vendor/bin/mago format --check",
        "quality": ["@analyse", "@lint", "@format:check"],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
